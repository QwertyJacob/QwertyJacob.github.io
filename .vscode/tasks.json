{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Pubblica tutto · GitHub + DiSTA",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/publish_site.sh"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Avvia GitHub Page in locale",
            "type": "process",
            "command": "python3",
            "args": ["-u", "-m", "http.server", "8000", "--bind", "127.0.0.1"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "local-site",
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP on",
                    "endsPattern": "^Serving HTTP on"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
